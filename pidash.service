[Unit]
Description=pidash — live Raspberry Pi metrics dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/local/bin/pidash -addr :8090
Restart=on-failure
RestartSec=5

# Runs as a login user rather than a dedicated service account, so it inherits
# the three group memberships it needs:
#   docker  -> /var/run/docker.sock
#   video   -> /dev/vchiq, for vcgencmd's firmware queries
#   adm     -> reading the journal
# install.sh rewrites these to whoever runs it; `pi` is only the default.
User=pi
Group=pi

# Read-only everywhere; the process writes nothing but its own log output.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
# AF_NETLINK is required: Go enumerates interface addresses over netlink, and
# without it every interface reports a blank IP.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
# PrivateDevices is deliberately off: it would hide /dev/vchiq and take the
# SoC temperature, core voltage and throttle flags with it.

[Install]
WantedBy=multi-user.target
